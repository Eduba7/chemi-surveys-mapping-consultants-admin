{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/trpc/:path*", "destination": "https://chemi-surveys-api.onrender.com/trpc/:path*" },
    { "source": "/api/:path*", "destination": "https://chemi-surveys-api.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://chemi-surveys-api.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
